        for ax1_inner_outer, ax1_inner_inner in T.grid(16, 8):
            T_cast_1 = T.Buffer((640,), "int8", data=T_cast.data)
            fused_nn_contrib_dense_pack_constant_9_1 = T.Buffer((640,), "int32", data=fused_nn_contrib_dense_pack_constant_9.data)
            T_cast_1[ax1_outer_ax0_outer_fused * 128 + ax1_inner_outer * 8 + ax1_inner_inner] = T.Cast("int8", T.max(T.min(T.q_multiply_shift(compute_1[ax1_inner_outer * 8 + ax1_inner_inner] + fused_nn_contrib_dense_pack_constant_9_1[ax1_outer_ax0_outer_fused * 128 + ax1_inner_outer * 8 + ax1_inner_inner], 1462485078, 31, -9) + 96, 127), -128))
