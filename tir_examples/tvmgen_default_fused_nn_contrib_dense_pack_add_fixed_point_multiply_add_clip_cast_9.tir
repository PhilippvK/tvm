# from tvm.script import tir as T

@T.prim_func
def tvmgen_default_fused_nn_contrib_dense_pack_add_fixed_point_multiply_add_clip_cast_9(p0: T.Buffer((1, 128), "int16"), T_cast: T.Buffer((1, 640), "int8"), fused_nn_contrib_dense_pack_constant_9: T.Buffer((1, 640), "int32"), fused_constant_9: T.Buffer((80, 128, 8), "int16")):
    T.func_attr({"from_legacy_te_schedule": T.bool(True), "tir.noalias": T.bool(True)})
    for ax1_outer_ax0_outer_fused in T.parallel(5):
        compute = T.allocate([128], "int32", "global")
        compute_global = T.allocate([8], "int32", "global")
        compute_1 = T.Buffer((128,), "int32", data=compute)
        for y_inner_outer_x_inner_outer_fused in range(16):
            compute_global_1 = T.Buffer((8,), "int32", data=compute_global, align=32)
            for x_c_init in range(8):
                compute_global_1[x_c_init] = 0
            for k_outer, x_c in T.grid(128, 8):
                p0_1 = T.Buffer((128,), "int16", data=p0.data)
                fused_constant_9_1 = T.Buffer((81920,), "int16", data=fused_constant_9.data)
                compute_global_1[x_c] = compute_global_1[x_c] + T.Cast("int32", p0_1[k_outer]) * T.Cast("int32", fused_constant_9_1[ax1_outer_ax0_outer_fused * 16384 + y_inner_outer_x_inner_outer_fused * 1024 + k_outer * 8 + x_c])
            for x_inner_inner in range(8):
